<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target Framework & Platform -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Assembly Information -->
    <AssemblyName>MSFSBlindAssist</AssemblyName>
    <RootNamespace>MSFSBlindAssist</RootNamespace>
    <AssemblyTitle>MSFS Blind Assist</AssemblyTitle>
    <Product>MSFS Blind Assist</Product>
    <Description>MSFS Blind Assist - Accessible Multi-Aircraft Control for Microsoft Flight Simulator</Description>
    <Copyright>Copyright © 2025</Copyright>
    <!-- Version is set by CI from the git tag: .github/workflows/release.yml passes
         -p:Version=<tag without the leading v> to the Release build, which the SDK
         derives AssemblyVersion / FileVersion / InformationalVersion from. The value
         below is ONLY the fallback for local builds, so it is deliberately 0.0.0 —
         an unmistakable "this is not a release" marker. Do NOT hardcode FileVersion
         (or AssemblyVersion) here: an explicit value overrides the derivation and
         silently pins that field while the others follow the tag, which is exactly
         how FileVersion sat at a stale 2.1.1.0 through every release up to v7.0.0. -->
    <Version>0.0.0</Version>
    <Guid>a1b2c3d4-e5f6-4321-8765-432109876543</Guid>

    <!-- Modern C# Features -->
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code Quality & Analysis -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- WebView2 ships a WPF wrapper (Microsoft.Web.WebView2.Wpf) that this WinForms-only app never
         loads, but it transitively references WindowsBase 5.0.0.0, conflicting with the .NET (net10)
         ref assembly (4.0.0.0). MSBuild resolves it CORRECTLY to the framework WindowsBase — the WPF
         control is never instantiated — so this is a benign third-party packaging conflict. Demote
         the MSB3277 reference-conflict warning to a build message. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>

    <!-- Build Settings -->
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- COM Interop -->
    <EnableComHosting>true</EnableComHosting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- External SDK Reference -->
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath Condition="Exists('$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <HintPath Condition="!Exists('$(MSFS_SDK)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">$(ProjectDir)..\lib\managed\Microsoft.FlightSimulator.SimConnect.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The vPilot pipe protocol, compiled from ONE source into both this app and the
         net48 vPilot plugin. Linked, never copied — the two ends of the wire must not
         be able to drift. Same pattern as tools/PMDGDispatchTester and PMDGNG3DataStruct.cs. -->
    <Compile Include="..\plugins\MSFSBlindAssist.VPilotPlugin\VPilotWireFormat.cs" Link="Services\VPilot\VPilotWireFormat.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet Packages -->
    <PackageReference Include="GeoTimeZone" Version="6.1.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <PackageReference Include="TimeZoneConverter" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content Files -->
    <None Update="SimConnect.cfg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Libraries\Tolk.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Hotkey Guide Files -->
    <None Update="HotkeyGuides\FBW_A320_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\FBW_A330_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\FBW_A380_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\Fenix_A320_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\PMDG_737_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\PMDG_777_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\HS787_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="HotkeyGuides\iFly_737MAX8_Hotkeys.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Checklist Files -->
    <None Update="Checklists\FBW_A320_Checklist.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Checklists\FBW_A330_Checklist.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Checklists\Fenix_A320_Checklist.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Checklists\FBW_A380_Checklist.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Checklists\iFly_737MAX8_Checklist.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- User-facing guides/manuals. Shipped in full (whole folder) so the in-app
         hotkey lists' "see Guides\..." references resolve next to the exe, and any
         future per-aircraft manual added here ships automatically. -->
    <None Update="Guides\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- navdatareader config: stock, plus the GSX World of Jetways exclusion. -->
    <None Update="Resources\navdatareader.cfg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Coherent in-page agents (injected at runtime via the remote debugger) -->
    <None Update="Resources\coherent-a380-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-hs787-cdu-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-hs787-irs-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-hs787-cas-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-a32nx-flightinfo.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-a32nx-dcdu.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-flypad-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-pmdg-efb-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-oans-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-ewd-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-display-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-rmp-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\coherent-ecl-agent.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\flypad-shell.html">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded Resources (Forms) -->
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="REM Copy both versioned SimConnect DLLs to output directory&#xD;&#xA;xcopy /Y &quot;$(ProjectDir)..\SimConnect_msfs_2020.dll&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;xcopy /Y &quot;$(ProjectDir)..\SimConnect_msfs_2024.dll&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;xcopy /Y &quot;$(ProjectDir)Libraries\Tolk.dll&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;xcopy /Y &quot;$(ProjectDir)..\nvda_controllerClient\x64\nvdaControllerClient.dll&quot; &quot;$(TargetDir)&quot;&#xD;&#xA;&#xD;&#xA;REM Copy navdatareader and all its dependencies to output directory (skip if not present)&#xD;&#xA;if exist &quot;$(ProjectDir)..\Navdatareader-win-1.2.4\&quot; (&#xD;&#xA;  if not exist &quot;$(TargetDir)navdatareader\&quot; mkdir &quot;$(TargetDir)navdatareader\&quot;&#xD;&#xA;  xcopy /Y /E /I &quot;$(ProjectDir)..\Navdatareader-win-1.2.4\*&quot; &quot;$(TargetDir)navdatareader\&quot;&#xD;&#xA;  REM Copy SimConnect.cfg to navdatareader directory for FS2024 SimConnect support&#xD;&#xA;  xcopy /Y &quot;$(ProjectDir)SimConnect.cfg&quot; &quot;$(TargetDir)navdatareader\&quot;&#xD;&#xA;)" />
  </Target>

  <ItemGroup>
    <!-- Build-order only. ReferenceOutputAssembly=false because a net10 project cannot
         reference a net48 assembly; SkipGetTargetFrameworkProperties stops MSBuild from
         rejecting the cross-framework reference outright. Nothing is linked — the copy
         below is what actually ships the DLL.

         SetPlatform="Platform=AnyCPU" is REQUIRED, not decorative — do not remove it.
         Platform is a command-line global property, and MSBuild passes a referencing
         project's global properties straight through to its ProjectReferences unless a
         ProjectReference overrides them. The plugin project only ever builds
         Any CPU (see its <Platforms>AnyCPU</Platforms> and the Debug|x64 -> Debug|Any CPU
         mapping in MSFSBlindAssist.sln), so without this override, building this csproj
         directly with an explicit platform — e.g.
         `dotnet build MSFSBlindAssist.csproj -c Debug -p:Platform=x64`, a command CLAUDE.md
         explicitly sanctions as an alternative to building the .sln — passes Platform=x64
         straight through to the plugin project too. That sends the plugin's output to
         bin\x64\Debug\net48\ instead of bin\Debug\net48\, a folder the Copy target below
         never looks at, so the copy below silently no-ops: either an empty vPilotPlugin\
         folder ships, or a stale DLL that never updates again. SetPlatform pins the
         plugin's build to Any CPU regardless of what platform this project is building as,
         so both build paths land in the same, predictable folder. -->
    <ProjectReference Include="..\plugins\MSFSBlindAssist.VPilotPlugin\MSFSBlindAssist.VPilotPlugin.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetPlatform="Platform=AnyCPU" Private="false" />
  </ItemGroup>

  <Target Name="CopyVPilotPlugin" AfterTargets="Build">
    <!-- Lands in $(OutDir), so it follows whichever output tree is being built and the
         release zip (which archives the whole output folder) picks it up with no
         workflow change. VPilotPluginInstaller reads it from here at run time.

         Deliberately NO Condition="Exists(...)" guard on the Copy below: a missing
         source must fail the build loudly (MSBuild's own "could not find file" error)
         rather than silently skipping the copy and reporting "Build succeeded" while
         either shipping an empty vPilotPlugin\ folder or leaving a stale DLL in place. -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\plugins\MSFSBlindAssist.VPilotPlugin\bin\$(Configuration)\net48\MSFSBlindAssist.VPilotPlugin.dll" DestinationFolder="$(OutDir)vPilotPlugin" SkipUnchangedFiles="true" />
  </Target>

</Project>
