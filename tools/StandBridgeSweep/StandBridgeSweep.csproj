<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Standalone measurement harness for re-measuring PR #235's stand-bridge headline
      figures against the real fs2024 navdata database, over the REAL production
      TaxiGraph.Build / RunwayShape / RunwayPavement — never a reimplementation. It links
      the file set tools/ProgressiveTaxiProbe uses for TaxiGraph (proven to compile as a
      set — see that probe), RunwayPavement.cs and the Utils/Logging logger included.
      Keep the two lists in step: when TaxiGraph gained its Log.Info call (7eee43c1) only
      ProgressiveTaxiProbe gained the logger, and this probe stopped building (CS0234).
    -->
    <!-- Navigation -->
    <Compile Include="..\..\MSFSBlindAssist\Navigation\TaxiGraph.cs"             Link="Linked\TaxiGraph.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\NavigationCalculator.cs"  Link="Linked\NavigationCalculator.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\LandingExit.cs"           Link="Linked\LandingExit.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\TaxiLeadIn.cs"            Link="Linked\TaxiLeadIn.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\HoldShortNodeResolver.cs" Link="Linked\HoldShortNodeResolver.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\RouteRunwayCrossings.cs"  Link="Linked\RouteRunwayCrossings.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\RunwayFrame.cs"           Link="Linked\RunwayFrame.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\RunwayShape.cs"           Link="Linked\RunwayShape.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\RunwayPavement.cs"        Link="Linked\RunwayPavement.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\RunwayRouteClassifier.cs" Link="Linked\RunwayRouteClassifier.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\RolloutExitGate.cs"       Link="Linked\RolloutExitGate.cs" />
    <!-- RolloutExitGate's comfortable too-fast pick is the touchdown re-plan's own rule (LandingExitReplan,
         pure: LandingExit + RolloutExitGate only). -->
    <Compile Include="..\..\MSFSBlindAssist\Navigation\LandingExitReplan.cs"     Link="Linked\LandingExitReplan.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\NamedHoldingPointResolver.cs" Link="Linked\NamedHoldingPointResolver.cs" />
    <!-- TaxiGraph logs through Utils/Logging/Log (missing here since before the landing-exit work, so
         this harness could not build), and TaxiGraph.cs is now partial: its landing-exit producers call
         ExitBranch (via TaxiGraph.ExitRefinement.cs). The same links tools/ProgressiveTaxiProbe carries. -->
    <Compile Include="..\..\MSFSBlindAssist\Utils\Logging\*.cs"                  Link="Linked\Logging\%(Filename)%(Extension)" />
    <Compile Include="..\..\MSFSBlindAssist\Utils\AppLogs.cs"                     Link="Linked\AppLogs.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\ExitBranch.cs"            Link="Linked\ExitBranch.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Navigation\TaxiGraph.ExitRefinement.cs" Link="Linked\TaxiGraph.ExitRefinement.cs" />
    <!-- ExitBranch's rescue-site walk caps a taxiway's width with PavementTolerance.WidthCapFeet. -->
    <Compile Include="..\..\MSFSBlindAssist\Navigation\PavementTolerance.cs"     Link="Linked\PavementTolerance.cs" />
    <!-- The whole-database bulk load, shared with the other sweep tool (linked, never copied). -->
    <Compile Include="..\Shared\NavdataSweepLoader.cs" Link="Shared\NavdataSweepLoader.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\DatabasePathResolver.cs" Link="Linked\DatabasePathResolver.cs" />
    <!-- Database models -->
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\TaxiNode.cs"         Link="Linked\TaxiNode.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\TaxiPath.cs"         Link="Linked\TaxiPath.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\ParkingSpot.cs"      Link="Linked\ParkingSpot.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\ParkingTypes.cs"     Link="Linked\ParkingTypes.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\GateSource.cs"       Link="Linked\GateSource.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\StartPosition.cs"    Link="Linked\StartPosition.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\Runway.cs"           Link="Linked\Runway.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Database\Models\TaxiRoute.cs"        Link="Linked\TaxiRoute.cs" />
    <!-- Services -->
    <Compile Include="..\..\MSFSBlindAssist\Services\DistanceFormatter.cs"       Link="Linked\DistanceFormatter.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Services\TaxiAugment\AirportTaxiData.cs"  Link="Linked\AirportTaxiData.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Services\TaxiAugment\TaxiGeo.cs"          Link="Linked\TaxiGeo.cs" />
    <Compile Include="..\..\MSFSBlindAssist\Services\TaxiAugment\TaxiDataMerger.cs"   Link="Linked\TaxiDataMerger.cs" />
    <!-- Settings -->
    <Compile Include="..\..\MSFSBlindAssist\Settings\DistanceUnit.cs"            Link="Linked\DistanceUnit.cs" />
  </ItemGroup>
  <!-- SimConnectStub.cs is auto-included by the SDK glob — no explicit entry needed. -->
</Project>
