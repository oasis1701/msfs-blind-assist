<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13</LangVersion>
    <RootNamespace>LayoutBundle</RootNamespace>
    <AssemblyName>LayoutBundle</AssemblyName>

    <!-- x64 only: it references MSFSBlindAssist.DisplayLayouts, which is x64 only. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MSFSBlindAssist.DisplayLayouts\MSFSBlindAssist.DisplayLayouts.csproj" />
  </ItemGroup>

</Project>
